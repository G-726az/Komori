{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Komori",
  "version": "0.1.0",
  "identifier": "io.github.komori.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1960",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com"
    },
    "windows": [
      {
        "label": "island",
        "title": "Komori",
        "url": "index.html",
        "width": 360,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "maximizable": false,
        "minimizable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Una islita en lo alto de tu pantalla",
    "longDescription": "Komori pone una islita en lo alto de tu pantalla, cuidada por una mascota en 3D: música, calendario y clima, sistema, tus apps, notas, herramientas, chat con IA, GitHub y avisos de Claude Code.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-side.bmp"
      }
    }
  }
}
